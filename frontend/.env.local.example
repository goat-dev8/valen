# Optional only if the Privy app uses a separate client id.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# --- Vercel deployment (Project Settings → Environment Variables) ---
# Required (Production + Preview):
#   NEXT_PUBLIC_API_URL=https://valen-api-m3g4.onrender.com
#   NEXT_PUBLIC_PRIVY_APP_ID=<your-privy-app-id>
#   OPERATOR_DASHBOARD_SECRET=<same value as Render backend>
#
# Recommended (Production + Preview):
#   NEXT_PUBLIC_BACKEND_URL=https://valen-api-m3g4.onrender.com
#   BACKEND_URL=https://valen-api-m3g4.onrender.com
#   NEXT_PUBLIC_CHAIN_IDS=421614,46630
#   NEXT_PUBLIC_ARBITRUM_SEPOLIA_* and NEXT_PUBLIC_ROBINHOOD_TESTNET_* (see above)
#
# Vercel project settings:
#   Root Directory: frontend
#   Framework: Next.js
#   Node.js Version: 20.x
